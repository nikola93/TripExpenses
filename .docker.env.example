# Copy to .docker.env (gitignored). Read by docker-compose.yml and
# docker-compose.dev.yml through env_file.

# Postgres container: creates this user and database on the first start.
POSTGRES_USER=tripexpenses
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tripexpenses

# Backend container: must match the values above. "db" is the compose service.
DATABASE_URL=postgres://tripexpenses:change-me@db:5432/tripexpenses?sslmode=disable
